{
 "sandbox": {
  "enabled": true,
  "failIfUnavailable": true,
  "autoAllowBashIfSandboxed": true,
  "allowUnsandboxedCommands": false,
  "network": {
   "allowedDomains": [],
   "strictAllowlist": true
  },
  "credentials": {
   "envVars": [
    {
     "name": "PROBE_SECRET",
     "mode": "deny"
    }
   ]
  }
 },
 "permissions": {
  "deny": [
   "WebFetch",
   "Read(//etc/**)"
  ]
 },
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "REPL",
    "hooks": [
     {
      "type": "command",
      "command": "python3 -I ~/p/agentic-search-bench/research/probes/claude-code-codemode/inject-hook.py"
     }
    ]
   }
  ]
 }
}